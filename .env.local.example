# Copy to .env.local (and paste the same values into the Vercel project's
# Environment Variables). Values are identical to landing/.env.local — the two
# sites talk to the same Supabase project.

# Supabase (public — safe to expose, ships in the JS bundle)
NEXT_PUBLIC_SUPABASE_URL=https://sxvnidtuspoxcgpzffdo.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase service role — SERVER ONLY. Never prefix with NEXT_PUBLIC_.
# Not needed by the current pages; required once admin writes / Bunny upload
# tickets land.
SUPABASE_SERVICE_ROLE_KEY=

# Bunny Stream — SERVER ONLY, used to mint direct-upload tickets.
# See ARCHITECTURE.md "Том файл оруулах" — the API key must never reach the
# browser; only the derived signature does.
BUNNY_STREAM_LIBRARY_ID=
BUNNY_STREAM_API_KEY=
