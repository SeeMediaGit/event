# events.seemedia.mn
#
# Хувьсагчийн НЭРС нь see_media_admin/.env-тэй яг ижил — нэг багц утгыг гурван
# төсөлд нэр өөрчлөхгүйгээр буулгаж болно. Утгуудыг see_media_admin/.env-ээс
# хуулж аваарай.
#
# Локал дээр `events/.env` (эсвэл `.env.local`) файлд тавина. Хоёулаа
# .gitignore-д орсон.

# ---------------------------------------------------------------------------
# Supabase — landing/, mobile/, see_media_admin/-тай нэг project
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
# Supabase-ийн одоогийн нэр. Өмнө нь "anon key" гэдэг байсан. Нийтийн key —
# JS bundle дотор явна, тэр нь хэвийн. Хамгаалалт нь RLS.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_DEFAULT_KEY=

# RLS-ийг тойрдог. ЗӨВХӨН server дээр — lib/supabase/server.ts нь
# `import "server-only"` тул client component-д импортлох гэвэл build унана.
# Хоёр нэрийн аль нэг нь байхад хангалттай; admin-ийн .env нь NEXT_PUBLIC_
# нэрээр нь өгдөг тул түүнийг ч уншина.
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Bunny Storage — бүтээлийн файл (4-р алхам).
# Bunny STREAM биш: файл нь storage zone-д объект болж хадгалагдаад CDN-ээс
# шууд дамждаг, admin панелийн медиатай яг ижил.
# Бүгд server-only — эдгээрийн аль нэгийг NEXT_PUBLIC_ болговол тэр key-тэй
# хүн танай бүх файлыг устгаж чадна.
# ---------------------------------------------------------------------------
BUNNY_STORAGE_ZONE=
BUNNY_STORAGE_REGION=
BUNNY_STORAGE_ACCESS_KEY=
BUNNY_CDN_BASE_URL=
# Заавал биш. Тавибал REGION-ыг дарж, эндпойнтыг шууд заана.
# BUNNY_STORAGE_ENDPOINT=
